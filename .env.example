# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.
# All of these are server-side only (read by /api). Never prefix them with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional: OpenAI handles the search-time text calls (parser + reasons); Gemini is the fallback.
OPENAI_API_KEY=



# "Continue with Google" needs no keys here: it uses Supabase Auth's Google provider. Turn it on in Supabase →
# Authentication → Sign In / Providers → Google, and add <your-site>/api/auth/google/callback to
# Authentication → URL Configuration → Redirect URLs.
