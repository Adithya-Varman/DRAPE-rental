# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.
# All of these are server-side only (read by /api). Never prefix them with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional: OpenAI handles the search-time text calls (parser + reasons); Gemini is the fallback.
OPENAI_API_KEY=

# Public (browser) settings for sign-in. The publishable key is safe to expose: every table has RLS on with no public
# policies, so it can only reach Supabase Auth. Supabase → Project Settings → API Keys → Publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
